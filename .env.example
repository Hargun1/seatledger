NODE_ENV=development
DATABASE_URL=postgresql://seatledger:seatledger_local_only@127.0.0.1:55432/seatledger
PORT=4100
PAYMENT_MODE=simulated
# Current demo policy: full cancellation before this many minutes ahead of show start.
CUSTOMER_CANCELLATION_CUTOFF_MINUTES=60
# Separate accepted-event cleanup worker; never starts with the API.
EVENT_CANCELLATION_BATCH_SIZE=5
EVENT_CANCELLATION_POLL_MS=1000
ALLOW_DEV_SEED=false
# Initialize a private local value with: npm run auth:secret
AUTH_SECRET=
# Optional 64-character hex bearer token for an external metrics scraper.
# Without it, /api/metrics requires an administrator's authenticated session.
# METRICS_TOKEN=
# Trace spans are sampled; request logs and metrics remain unsampled.
TRACE_SAMPLE_RATE=0.05
# Optional AI assistant. These variables belong on the API server only.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative, only used with AI_PROVIDER=openai. No automatic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_USER_TURNS_PER_HOUR=20
AI_GLOBAL_TURNS_PER_HOUR=50
AI_GLOBAL_TURNS_PER_DAY=200
AI_CONVERSATIONS_PER_DAY=5
PUBLIC_ORIGIN=http://127.0.0.1:5173
# Optional expiry worker: separate local process, never starts with the API.
EXPIRY_BATCH_SIZE=20
EXPIRY_POLL_MS=1000
# Optional local provider-creation worker (no real gateway).
PAYMENT_WORKER_BATCH_SIZE=5
PAYMENT_WORKER_POLL_MS=1000
PAYMENT_WORKER_LEASE_SECONDS=30
SIMULATOR_SCENARIO=success
# Optional signed callback endpoint: npm run payments:secret (separate private key).
# Absent key disables only this endpoint with 503; never reuse AUTH_SECRET.
# Optional separate inbox processor; delivery runs in its own worker, no real gateway.
INBOX_BATCH_SIZE=10
INBOX_POLL_MS=1000
# Local-only automatic signed callback delivery; API and other workers stay separate.
DELIVERY_BATCH_SIZE=5
DELIVERY_POLL_MS=1000
DELIVERY_LEASE_SECONDS=30
DELIVERY_HTTP_TIMEOUT_MS=2000
DELIVERY_MAX_ATTEMPTS=8
# Optional SIMULATOR_CALLBACK_URL uses the exact loopback callback route; defaults to PORT.
